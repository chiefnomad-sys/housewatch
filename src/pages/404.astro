---
import Base from '../layouts/Base.astro';
import HMark from '../components/HMark.astro';
---
<Base title="Page not found">
  <article class="page wrap"><div class="col" style="text-align:center">
    <div style="width:70px;margin:10px auto 18px"><HMark /></div>
    <h1>Nothing on this run.</h1>
    <p class="dek">That page doesn't exist or has moved.</p>
    <p style="margin-top:16px"><a class="textlink" href="/">Back to the news</a></p>
  </div></article>
</Base>
