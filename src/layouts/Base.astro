---
import '@fontsource/oswald/400.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/anton/400.css';
import '@fontsource-variable/source-serif-4/index.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import Daily from '../components/Daily.astro';
import { SITE } from '../site';

const {
  title,
  description = SITE.description,
  active = '',
  ogImage = '/og/default.png',
  ogType = 'website',
  published,
  section,
  daily = true,
} = Astro.props;
const full = title ? `${title} | Housewatch` : `Housewatch | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="en" data-look={SITE.look}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={SITE.look === 'black' ? '#0b0b0b' : '#ffffff'} />
    <link rel="alternate" type="application/rss+xml" title="Housewatch" href="/rss.xml" />
    <meta property="og:site_name" content="Housewatch" />
    <meta property="og:title" content={title ?? full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {published && <meta property="article:published_time" content={published} />}
    {section && <meta property="article:section" content={section} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the news</a>
    <Icons />
    <Header active={active} />
    <main id="main"><slot /></main>
    {daily && <Daily />}
    <slot name="after-main" />
    <Footer />
    <div class="toast" id="toast" role="status" hidden></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
